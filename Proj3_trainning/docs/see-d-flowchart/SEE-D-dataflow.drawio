        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="b1" target="b2">
