<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" agent="Codex" version="24.7.17" type="device">
  <diagram id="see-d-page-1" name="01-端到端总览">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SEE-D：从事件流到眼中心坐标的端到端数据流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="依据本地论文与 Proj3_trainning/software；蓝=数据/稀疏表示，绿=SCNN，紫=GRU/FC，橙=训练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;原始 3ET 记录&lt;/b&gt;&lt;br&gt;HDF5: events&lt;br&gt;[t,x,y,p], t=μs&lt;br&gt;640×480；p∈{0,1}&lt;br&gt;&lt;br&gt;label.txt&lt;br&gt;float32；100 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="155" width="205" height="150" as="geometry" />
        </mxCell>
        <mxCell id="transform" value="&lt;b&gt;空间/时间变换&lt;/b&gt;&lt;br&gt;事件坐标 ×0.125&lt;br&gt;标签每 5 个取 1 个&lt;br&gt;标签坐标归一化&lt;br&gt;&lt;br&gt;640×480 → 80×60&lt;br&gt;100 Hz → 20 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="155" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="slice" value="&lt;b&gt;序列切片与表示&lt;/b&gt;&lt;br&gt;窗口 1.5 s，步长 50 ms&lt;br&gt;30 × 50 ms 事件片&lt;br&gt;每片 3-bin voxel grid&lt;br&gt;&lt;br&gt;float32 [30,3,60,80]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="585" y="155" width="245" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sparse" value="&lt;b&gt;稠密 → 稀疏&lt;/b&gt;&lt;br&gt;合并 B 与 T&lt;br&gt;[BT,60,80,3]&lt;br&gt;仅保留三通道绝对值和≠0&lt;br&gt;&lt;br&gt;coord [N,3]=(bt,y,x)&lt;br&gt;feat [N,3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="875" y="155" width="245" height="150" as="geometry" />
        </mxCell>
        <mxCell id="scnn" value="&lt;b&gt;SEE-D 稀疏 MobileNetV2 主干&lt;/b&gt;&lt;br&gt;初始 3×3 s2: 3→24&lt;br&gt;9 个倒残差块&lt;br&gt;末端 1×1: 256→64&lt;br&gt;稀疏全局平均池化&lt;br&gt;&lt;br&gt;每个时间片 → 64-D embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1165" y="140" width="370" height="180" as="geometry" />
        </mxCell>
        <mxCell id="seq" value="&lt;b&gt;恢复时间维&lt;/b&gt;&lt;br&gt;pool 后 x.F: [B×T,64]&lt;br&gt;view → [B,30,64]&lt;br&gt;&lt;br&gt;每个 50 ms 片一个特征向量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="405" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="gru" value="&lt;b&gt;GRU（1 层）&lt;/b&gt;&lt;br&gt;input_size=64&lt;br&gt;hidden_size=64&lt;br&gt;batch_first=True&lt;br&gt;&lt;br&gt;输出 [B,30,64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="405" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="fc" value="&lt;b&gt;逐时间步 FC&lt;/b&gt;&lt;br&gt;Linear 64→2&lt;br&gt;&lt;br&gt;输出 [B,30,2]&lt;br&gt;归一化 (x,y)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1030" y="405" width="255" height="145" as="geometry" />
        </mxCell>
        <mxCell id="xy" value="&lt;b&gt;眼中心&lt;/b&gt;&lt;br&gt;x_px = x·80&lt;br&gt;y_px = y·60&lt;br&gt;&lt;br&gt;论文部署：&lt;br&gt;每片持续输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1360" y="405" width="175" height="145" as="geometry" />
        </mxCell>
        <mxCell id="trainlane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFDFE;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=1;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="1485" height="235" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="&lt;b&gt;当前 Proj3 float32 训练&lt;/b&gt;&lt;br&gt;MobileNetSubmanifold&lt;br&gt;Adam，lr=0.001，100 epochs&lt;br&gt;batch=20，weighted MSE&lt;br&gt;参数量：177,970" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;监督与指标&lt;/b&gt;&lt;br&gt;loss：全部 30 步 (x,y)&lt;br&gt;权重 [4/3, 1]&lt;br&gt;p5/p10：仅最后一步&lt;br&gt;Dist：全部 30 步，80×60 尺度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="690" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="qat" value="&lt;b&gt;论文 int8 路径&lt;/b&gt;&lt;br&gt;float32 预训练 → HAWQv3 QAT&lt;br&gt;SCNN 输入与权重 int8&lt;br&gt;GRU+FC 保持 CPU 浮点 SIMD&lt;br&gt;&lt;br&gt;不是本次 float32 run.sh 的同一路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="805" y="690" width="310" height="150" as="geometry" />
        </mxCell>
        <mxCell id="paper" value="&lt;b&gt;论文 Table 2：SEE-D&lt;/b&gt;&lt;br&gt;p5 81.37%｜p10 99.53%｜Dist 3.71 px&lt;br&gt;SCNN 0.59 ms｜GRU+FC 0.11 ms&lt;br&gt;总延迟 0.70 ms｜功耗 3.86 W&lt;br&gt;单次能耗 2.29 mJ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1180" y="690" width="325" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3973B9;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="raw" target="transform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3973B9;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="transform" target="slice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3973B9;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="slice" target="sparse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="sparse" target="scnn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="scnn" target="seq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="seq" target="gru">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="gru" target="fc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="fc" target="xy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C97816;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="cfg" target="loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="部署前另行量化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C97816;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="loss" target="qat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C97816;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="qat" target="paper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="see-d-page-2" name="02-数据预处理与格式">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SEE-D 数据预处理：时间、空间、缓存与批处理格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="本页严格按 ThreeET_plus.py、custom_transforms.py、regression_dataset.py、main.py 和 SEE-D.json 展开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="event_h5" value="&lt;b&gt;HDF5 /events&lt;/b&gt;&lt;br&gt;原始 dtype: 4×uint64&lt;br&gt;字段 [t,x,y,p]&lt;br&gt;t：微秒；x∈[0,639]&lt;br&gt;y∈[0,479]；p∈{0,1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="145" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="event_load" value="&lt;b&gt;ThreeETplus.__getitem__&lt;/b&gt;&lt;br&gt;astype structured int&lt;br&gt;p = p×2−1&lt;br&gt;得到 p∈{−1,+1}&lt;br&gt;&lt;br&gt;事件数组 [Ne]，Ne 可变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="145" width="245" height="170" as="geometry" />
        </mxCell>
        <mxCell id="event_down" value="&lt;b&gt;Tonic Downsample&lt;/b&gt;&lt;br&gt;spatial_factor=0.125&lt;br&gt;x,y 坐标缩至 1/8&lt;br&gt;&lt;br&gt;有效传感器尺寸&lt;br&gt;(W,H,P)=(80,60,2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="145" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="label_txt" value="&lt;b&gt;label.txt&lt;/b&gt;&lt;br&gt;每行 '(...)' → float32&lt;br&gt;原始频率 100 Hz&lt;br&gt;至少含 [x,y,eye_state]&lt;br&gt;&lt;br&gt;x,y 为 640×480 像素坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="380" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="label_scale" value="&lt;b&gt;标签变换&lt;/b&gt;&lt;br&gt;ScaleLabel(0.125)&lt;br&gt;TemporalSubsample(0.2)&lt;br&gt;即 labels[::5]&lt;br&gt;&lt;br&gt;100 Hz → 20 Hz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="380" width="245" height="170" as="geometry" />
        </mxCell>
        <mxCell id="label_norm" value="&lt;b&gt;NormalizeLabel&lt;/b&gt;&lt;br&gt;x÷80，y÷60&lt;br&gt;合并前一步等价于&lt;br&gt;x_original÷640&lt;br&gt;y_original÷480&lt;br&gt;&lt;br&gt;target float32 [L,≥3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="380" width="250" height="170" as="geometry" />
        </mxCell>
        <mxCell id="long_slice" value="&lt;b&gt;长序列滑窗&lt;/b&gt;&lt;br&gt;SliceByTimeEventsTargets&lt;br&gt;window = 30×50 ms = 1.5 s&lt;br&gt;stride = 50 ms&lt;br&gt;overlap = 1.45 s&lt;br&gt;include_incomplete=False&lt;br&gt;&lt;br&gt;事件与 30 个标签同步切片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="145" width="275" height="235" as="geometry" />
        </mxCell>
        <mxCell id="audit_stride" value="&lt;b&gt;审计提示：验证步长&lt;/b&gt;&lt;br&gt;train_stride=1&lt;br&gt;val_stride=1&lt;br&gt;所以训练和验证都每 50 ms 滑动。&lt;br&gt;&lt;br&gt;main.py 中“validation non-overlapping”注释与当前配置不一致。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE5E2;strokeColor=#C7463A;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1270" y="145" width="280" height="235" as="geometry" />
        </mxCell>
        <mxCell id="short_slice" value="&lt;b&gt;序列内二次切片&lt;/b&gt;&lt;br&gt;SliceLongEventsToShort&lt;br&gt;time_window=50,000 μs&lt;br&gt;overlap=0&lt;br&gt;&lt;br&gt;1.5 s → 30 个事件片&lt;br&gt;每片对应一个 20 Hz 标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="275" height="190" as="geometry" />
        </mxCell>
        <mxCell id="voxel" value="&lt;b&gt;3-bin Voxel Grid&lt;/b&gt;&lt;br&gt;每个 50 ms 事件片&lt;br&gt;to_voxel_grid_numpy&lt;br&gt;有符号极性按时间插值累加&lt;br&gt;squeeze polarity 轴&lt;br&gt;&lt;br&gt;每序列 [30,3,60,80] float32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1270" y="430" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&lt;b&gt;SlicedDataset + DiskCachedDataset&lt;/b&gt;&lt;br&gt;metadata：切片索引&lt;br&gt;cache：voxel grid + target&lt;br&gt;首次 epoch 生成较慢&lt;br&gt;后续 epoch 从磁盘缓存读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="680" width="275" height="205" as="geometry" />
        </mxCell>
        <mxCell id="augment" value="&lt;b&gt;仅训练集增强&lt;/b&gt;&lt;br&gt;Flip p=0.5：W 轴翻转，x→1−x&lt;br&gt;Shift p=0.5，max_shift=20&lt;br&gt;同时移动 voxel 与归一化标签&lt;br&gt;&lt;br&gt;&lt;font color='#C7463A'&gt;轴审计：代码把 shift_x/shift_y&lt;br&gt;传给数组 H/W 轴，命名需谨慎解释&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1270" y="680" width="280" height="205" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="&lt;b&gt;DataLoader 输出（送入模型）&lt;/b&gt;&lt;br&gt;inputs: torch.float32 [B,30,3,60,80]&lt;br&gt;targets: torch.float32 [B,30,≥3]&lt;br&gt;masked_lengths: int tensor；当前 flip+shift 配置通常全 0&lt;br&gt;&lt;br&gt;B=20（默认全训练）；shuffle：train=True，val=False&lt;br&gt;pin_memory：train=True" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=14;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
