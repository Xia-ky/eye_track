  <diagram id="see-d-page-4" name="04-训练量化与异构部署">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SEE-D：GRU 回归、训练指标、int8 量化与 Zynq 异构部署边界" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="左侧是当前 Proj3 float32 训练；右侧是论文部署链。两者共享 SEE-D 拓扑，但数值格式和执行设备不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="embedding" value="&lt;b&gt;SCNN embedding&lt;/b&gt;&lt;br&gt;GlobalAvgPool 后&lt;br&gt;x.F [B×30,64]&lt;br&gt;view → [B,30,64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="150" width="245" height="135" as="geometry" />
        </mxCell>
        <mxCell id="gru" value="&lt;b&gt;标准 PyTorch GRU&lt;/b&gt;&lt;br&gt;1 层，64→64&lt;br&gt;batch_first=True&lt;br&gt;输出 [B,30,64]&lt;br&gt;&lt;font color='#526174'&gt;不是 ConvGRU.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="355" y="150" width="245" height="135" as="geometry" />
        </mxCell>
        <mxCell id="fc" value="&lt;b&gt;Linear 回归头&lt;/b&gt;&lt;br&gt;64→2&lt;br&gt;逐时间步执行&lt;br&gt;output [B,30,2]&lt;br&gt;归一化 (x,y)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="655" y="150" width="220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="target" value="&lt;b&gt;监督 target&lt;/b&gt;&lt;br&gt;[B,30,≥3]&lt;br&gt;训练仅取 [:,:,:2]&lt;br&gt;eye_state 列不进入坐标 loss&lt;br&gt;&lt;br&gt;单位：归一化坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="375" width="245" height="165" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;Weighted MSE&lt;/b&gt;&lt;br&gt;全部 30 个时间步&lt;br&gt;weights=[640/480,1]&lt;br&gt;即 x 误差权重 4/3&lt;br&gt;&lt;br&gt;反向传播到 SCNN+GRU+FC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="355" y="375" width="245" height="165" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;验证指标&lt;/b&gt;&lt;br&gt;p5/p10/p15：只用最后一步&lt;br&gt;误差换算尺度 80×60&lt;br&gt;Dist：全部 30 步欧氏距离均值&lt;br&gt;&lt;br&gt;保存 best val loss / p5 / p10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="655" y="375" width="300" height="165" as="geometry" />
        </mxCell>
        <mxCell id="artifacts" value="&lt;b&gt;当前 Proj3 训练产物&lt;/b&gt;&lt;br&gt;model_epoch*.pth｜model_last_epoch100.pth&lt;br&gt;model_best_val_loss.pth｜model_best_p5_acc.pth｜model_best_p10_acc.pth&lt;br&gt;MLflow：args.json、cfg.json、log.txt、metrics/artifacts&lt;br&gt;&lt;br&gt;当前配置 architecture=MobileNetSubmanifold（float32）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="650" width="545" height="190" as="geometry" />
        </mxCell>
        <mxCell id="quant" value="&lt;b&gt;论文部署前：HAWQv3 量化感知微调&lt;/b&gt;&lt;br&gt;float32 checkpoint → MobileNetSubmanifoldQuant&lt;br&gt;SCNN 的输入激活 X 与权重 W 量化为 int8&lt;br&gt;乘法、加法、移位构成整数图；比例除法变为额外整数乘法+shift&lt;br&gt;&lt;br&gt;GRU+FC 未并入 FPGA int8 SCNN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D6;strokeColor=#C97816;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1015" y="150" width="515" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fpga" value="&lt;b&gt;FPGA Programmable Logic&lt;/b&gt;&lt;br&gt;输入：binary bitmap + sparse feature&lt;br&gt;token=(x,y,end) + feature stream&lt;br&gt;&lt;br&gt;Tokenize → sparse conv blocks&lt;br&gt;1×1 / SLB / DW3×3 / residual&lt;br&gt;→ sparse global pooling&lt;br&gt;&lt;br&gt;SCNN：int8｜论文 0.59 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1015" y="390" width="310" height="230" as="geometry" />
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;ARM Cortex-A53&lt;/b&gt;&lt;br&gt;接收 64-D embedding&lt;br&gt;&lt;br&gt;GRU + FC&lt;br&gt;Eigen C++&lt;br&gt;NEON SIMD&lt;br&gt;浮点&lt;br&gt;&lt;br&gt;论文 0.11 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECE5FA;strokeColor=#7356A8;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1370" y="390" width="160" height="230" as="geometry" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;论文 Table 2：SEE-D 端到端结果&lt;/b&gt;&lt;br&gt;p5=81.37%｜p10=99.53%｜Dist=3.71 px｜参数≈178K&lt;br&gt;总延迟=0.70 ms｜功耗=3.86 W｜能耗=2.29 mJ/inf&lt;br&gt;资源：DSP 1606｜BRAM 1092｜FF 90K｜LUT 130K&lt;br&gt;&lt;br&gt;&lt;font color='#C7463A'&gt;这些是论文量化异构系统结果，不可直接等同于本次 GPU float32 训练日志。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=13;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1015" y="690" width="515" height="170" as="geometry" />
        </mxCell>
