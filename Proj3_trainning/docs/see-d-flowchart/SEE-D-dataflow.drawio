  <diagram id="see-d-page-3" name="03-SEE-D逐倒残差块">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SEE-D 稀疏主干：精确到每一个倒残差块" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每块均为 1×1 expand → 3×3 depthwise sparse conv → 1×1 project；残差仅在 stride=1 且 Cin=Cout 时启用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#F7F9FC;strokeWidth=0;fontColor=#18212F;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="dense" value="&lt;b&gt;模型输入&lt;/b&gt;&lt;br&gt;[B,30,3,60,80]&lt;br&gt;view → [B×30,3,60,80]&lt;br&gt;permute → [B×30,60,80,3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="265" height="135" as="geometry" />
        </mxCell>
        <mxCell id="to_sparse" value="&lt;b&gt;dense_to_sparse&lt;/b&gt;&lt;br&gt;mask = abs(C).sum≠0&lt;br&gt;coord [N,3]=(bt,y,x), int32&lt;br&gt;feat [N,3], float32&lt;br&gt;Minkowski SparseTensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#3973B9;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="130" width="295" height="135" as="geometry" />
        </mxCell>
        <mxCell id="stem" value="&lt;b&gt;Stem：ConvBNReLU&lt;/b&gt;&lt;br&gt;Sparse Conv 3×3, s=2, 3→24&lt;br&gt;BN + ReLU6&lt;br&gt;逻辑 H×W: 60×80 → 30×40&lt;br&gt;tensor_stride: 1 → 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="690" y="130" width="300" height="135" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;读法&lt;/b&gt;&lt;br&gt;E = 1×1 sparse conv + BN + ReLU6&lt;br&gt;DW = 3×3 channelwise + BN + ReLU6；P = 1×1 sparse conv + BN（无激活）&lt;br&gt;C @ H×W；N 随稀疏度变化；stride=1 不主动扩张活跃坐标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="125" width="515" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b0" value="&lt;b&gt;Block 0｜stage [8,32,1,2]&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：24 @ 30×40&lt;br&gt;E 24→192&lt;br&gt;DW 192, s2&lt;br&gt;P 192→32&lt;br&gt;输出：32 @ 15×20&lt;br&gt;残差：否｜tensor_stride=4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="340" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;Block 1｜stage [6,48,2,2] #1&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：32 @ 15×20&lt;br&gt;E 32→192&lt;br&gt;DW 192, s2&lt;br&gt;P 192→48&lt;br&gt;输出：48 @ 8×10&lt;br&gt;残差：否｜tensor_stride=8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="355" y="340" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;Block 2｜stage [6,48,2,2] #2&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：48 @ 8×10&lt;br&gt;E 48→288&lt;br&gt;DW 288, s1&lt;br&gt;P 288→48&lt;br&gt;输出：48 @ 8×10&lt;br&gt;残差：是｜tensor_stride=8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="665" y="340" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;Block 3｜stage [1,64,2,1] #1&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：48 @ 8×10&lt;br&gt;E 48→48&lt;br&gt;DW 48, s1&lt;br&gt;P 48→64&lt;br&gt;输出：64 @ 8×10&lt;br&gt;残差：否｜tensor_stride=8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="975" y="340" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;Block 4｜stage [1,64,2,1] #2&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：64 @ 8×10&lt;br&gt;E 64→64&lt;br&gt;DW 64, s1&lt;br&gt;P 64→64&lt;br&gt;输出：64 @ 8×10&lt;br&gt;残差：是｜tensor_stride=8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1285" y="340" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;Block 5｜stage [1,72,3,2] #1&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：64 @ 8×10&lt;br&gt;E 64→64&lt;br&gt;DW 64, s2&lt;br&gt;P 64→72&lt;br&gt;输出：72 @ 4×5&lt;br&gt;残差：否｜tensor_stride=16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="610" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;Block 6｜stage [1,72,3,2] #2&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：72 @ 4×5&lt;br&gt;E 72→72&lt;br&gt;DW 72, s1&lt;br&gt;P 72→72&lt;br&gt;输出：72 @ 4×5&lt;br&gt;残差：是｜tensor_stride=16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="355" y="610" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="&lt;b&gt;Block 7｜stage [1,72,3,2] #3&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：72 @ 4×5&lt;br&gt;E 72→72&lt;br&gt;DW 72, s1&lt;br&gt;P 72→72&lt;br&gt;输出：72 @ 4×5&lt;br&gt;残差：是｜tensor_stride=16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="665" y="610" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="&lt;b&gt;Block 8｜stage [1,256,1,1]&lt;/b&gt;&lt;br&gt;&lt;br&gt;输入：72 @ 4×5&lt;br&gt;E 72→72&lt;br&gt;DW 72, s1&lt;br&gt;P 72→256&lt;br&gt;输出：256 @ 4×5&lt;br&gt;残差：否｜tensor_stride=16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="975" y="610" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="tail" value="&lt;b&gt;Tail 1×1 ConvBNReLU&lt;/b&gt;&lt;br&gt;256→64，s=1，BN+ReLU6&lt;br&gt;64 @ 4×5；tensor_stride=16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1285" y="610" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;Minkowski GlobalAvgPool&lt;/b&gt;&lt;br&gt;每个 (batch,time) 的活跃点均值&lt;br&gt;[B×30,64]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F3E8;strokeColor=#2E8B57;strokeWidth=2;fontColor=#18212F;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1285" y="735" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;尺寸口径：&lt;/b&gt;H×W 为稀疏坐标的逻辑包围尺寸；60×80 经 s2 → 30×40 → 15×20 → 8×10 → 4×5。 MinkowskiEngine 实际存储的是活跃坐标与特征，内存并不分配完整稠密网格。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F6;strokeColor=#7B8795;strokeWidth=2;fontColor=#18212F;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;spacing=8;dashed=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="870" width="1510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3973B9;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="dense" target="to_sparse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="to_sparse" target="stem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E8B57;strokeWidth=2;dashed=0;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="stem" target="b0">
          <mxGeometry relative="1" as="geometry" />
